# Copy to .env, fill in, then load before `cdk deploy`:
#   set -a; source .env; set +a
# The CDK stack reads these from the environment and passes them to the Lambdas.

# Sarvam AI key: speech-to-text (Saaras v3) and document translation
SARVAM_API_KEY=

# Legacy: the AI now runs on AWS Bedrock; the stack still reads this, it can stay empty
GROQ_API_KEY=

